# Login-shell env for zsh (runs before .zshrc).

# Homebrew on Apple Silicon
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

export LSCOLORS=ExGxBxDxCxEgEdxbxgxcxd

# Go: `go install` drops binaries (gopls, dlv, staticcheck, goimports) here,
# and nothing else puts $GOPATH/bin on PATH.
if [ -d "$HOME/go/bin" ]; then
    export PATH="$HOME/go/bin:$PATH"
fi

# ----- locally built toolchain -----
# A source-built emacs/go/clangd prefix, present only on machines that have
# one (e.g. a box whose system emacs is too old). Guarded, so this is a no-op
# everywhere else.
[ -f "$HOME/opt/env.sh" ] && . "$HOME/opt/env.sh"

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
