# csh/tcsh startup. Runs for every shell invocation (login and non-login).
# csh has no .cshenv / .cprofile — .cshrc is the single per-user file.

# ----- aliases -----
# csh syntax: `alias name 'command'` (no equals sign, single quotes).
alias ll 'ls -al'
alias c  'clear'

# ----- PATH -----
if (-d /opt/homebrew/bin) then
    setenv PATH "/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
endif
if (-d $HOME/.local/bin) then
    setenv PATH "$HOME/.local/bin:$PATH"
endif
# Go: `go install` drops gopls, dlv, staticcheck here.
if (-d $HOME/go/bin) then
    setenv PATH "$HOME/go/bin:$PATH"
endif

# ----- locally built toolchain -----
# A source-built emacs/go/clangd prefix, present only on machines that have
# one (e.g. a box whose system emacs is too old). Guarded, so this is a no-op
# everywhere else.
if (-f $HOME/opt/env.csh) then
    source $HOME/opt/env.csh
endif

# ----- ls colors -----
setenv LSCOLORS ExGxBxDxCxEgEdxbxgxcxd
